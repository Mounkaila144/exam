APP_NAME=ExamGuard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — PostgreSQL 16 (Docker compose)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=examguard
DB_USERNAME=examguard
DB_PASSWORD=secret

# Redis 7 — queue + cache + sessions
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis

# Broadcasting — Laravel Reverb
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=examguard-app
REVERB_APP_KEY=examguard-key
REVERB_APP_SECRET=examguard-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@examguard.local"
MAIL_FROM_NAME="${APP_NAME}"

# File storage — S3-compatible (MinIO en dev, S3 ou compatible en prod)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=examguard
AWS_SECRET_ACCESS_KEY=examguard-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=examguard
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_URL=http://127.0.0.1:9000/examguard

# Web Push (VAPID) — generate with `php artisan vapid:generate`
VAPID_SUBJECT="mailto:admin@examguard.local"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Claude API — the key itself is stored encrypted in platform_settings (admin UI)
ANTHROPIC_API_BASE=https://api.anthropic.com
CLAUDE_DEFAULT_MODEL=claude-opus-4-7
CLAUDE_TIMEOUT_SECONDS=180

VITE_APP_NAME="${APP_NAME}"
